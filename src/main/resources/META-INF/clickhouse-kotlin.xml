<idea-plugin>
    <extensions defaultExtensionNs="dev.sort.clickhouse">
        <relationFacts implementation="dev.sort.clickhouse.brikk.kotlin.ClickHouseBrikkRelationFacts"/>
        <inspectionRule implementation="dev.sort.clickhouse.brikk.kotlin.ClickHouseBrikkInspectionRule"/>
    </extensions>
    <extensions defaultExtensionNs="com.intellij">
        <languageInjectionContributor language="kotlin" implementationClass="dev.sort.clickhouse.brikk.kotlin.ClickHouseBrikkInjector" order="first"/>
        <languageInjectionPerformer language="kotlin" implementationClass="dev.sort.clickhouse.brikk.kotlin.ClickHouseBrikkInjector" order="first"/>
        <externalAnnotator language="kotlin" implementationClass="dev.sort.clickhouse.validation.ClickHouseNativeErrorAnnotator"/>
    </extensions>
</idea-plugin>
